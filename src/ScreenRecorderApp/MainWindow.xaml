<Window x:Class="ScreenRecorderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enregistreur d'écran"
        Height="772" Width="468"
        MinHeight="700" MinWidth="468"
        FontFamily="Segoe UI"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20" TextElement.Foreground="{StaticResource TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,18">
            <Ellipse Width="14" Height="14" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Enregistreur d'écran" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Settings -->
        <StackPanel Grid.Row="1" x:Name="SettingsPanel">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ÉCRAN" Style="{StaticResource SectionHeader}"/>
                    <ComboBox x:Name="ScreenComboBox" Style="{StaticResource ModernCombo}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="CAMÉRA" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <CheckBox x:Name="WebcamCheckBox" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                  Checked="WebcamCheckBox_Toggled" Unchecked="WebcamCheckBox_Toggled"/>
                    </Grid>
                    <ComboBox x:Name="WebcamComboBox" Style="{StaticResource ModernCombo}" IsEnabled="False"/>
                    <TextBlock Text="Incrustée en rond, en bas à droite de la vidéo." Style="{StaticResource MutedText}" Margin="2,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="MICRO" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <CheckBox x:Name="MicrophoneCheckBox" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                  Checked="MicrophoneCheckBox_Toggled" Unchecked="MicrophoneCheckBox_Toggled"/>
                    </Grid>
                    <ComboBox x:Name="MicrophoneComboBox" Style="{StaticResource ModernCombo}" IsEnabled="False"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="DOSSIER D'ENREGISTREMENT" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,0" Height="34" Margin="0,0,8,0">
                            <TextBlock x:Name="OutputPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource BodyText}"/>
                        </Border>
                        <Button Grid.Column="1" Content="Choisir…" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="ChooseFolderButton_Click"/>
                        <Button Grid.Column="2" Content="Ouvrir" Style="{StaticResource SmallButton}" Click="OpenFolderButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer / controls -->
        <StackPanel Grid.Row="2">
            <Grid Margin="0,4,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RecordButton" Grid.Column="0" Content="Enregistrer" Style="{StaticResource RecordButton}"
                        Margin="0,0,12,0" Click="RecordButton_Click"/>
                <Button x:Name="RestartButton" Grid.Column="1" Content="⟳" FontSize="22" Width="52"
                        Style="{StaticResource GhostButton}" IsEnabled="False" Click="RestartButton_Click"
                        ToolTip="Recommencer : annule la vidéo en cours et relance immédiatement (Ctrl+Alt+R)"/>
            </Grid>

            <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
            <TextBlock x:Name="StatusText" Text="Prêt." Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HotkeyHintText" TextAlignment="Center" HorizontalAlignment="Center"
                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Une barre de contrôle apparaît en bas à gauche pendant l'enregistrement. Raccourcis : Ctrl+Alt+S arrêter · Ctrl+Alt+P pause · Ctrl+Alt+R recommencer"/>
        </StackPanel>
    </Grid>
</Window>
