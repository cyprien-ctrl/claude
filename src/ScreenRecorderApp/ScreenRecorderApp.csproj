<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ScreenRecorderApp</AssemblyName>
    <RootNamespace>ScreenRecorderApp</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      ScreenRecorderLib et OpenCvSharp sont des composants natifs compilés pour une
      architecture précise (x64). AnyCPU n'est pas supporté, donc on force x64.
    -->
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Capture + encodage écran/micro (Desktop Duplication + Media Foundation). -->
    <PackageReference Include="ScreenRecorderLib" Version="6.3.0" />

    <!-- Capture de la webcam pour l'incrustation ronde (rendue par l'app, pas par ScreenRecorderLib). -->
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260627" />
  </ItemGroup>

</Project>
