<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenRecorderApp</AssemblyName>
    <RootNamespace>ScreenRecorderApp</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      ScreenRecorderLib est une DLL mixte native/managée compilée pour x86/x64/ARM64.
      Elle exige que $(Platform) soit explicitement défini (AnyCPU n'est pas supporté),
      donc on force x64 par défaut si rien n'est précisé sur la ligne de commande.
    -->
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.3.0" />
  </ItemGroup>

  <!--
    Activer WPF et WinForms ensemble importe automatiquement System.Windows (WPF) et
    System.Windows.Forms (WinForms), qui définissent tous les deux "Application",
    "MessageBox", etc. On retire l'import automatique de WinForms ; le seul type
    WinForms utilisé (FolderBrowserDialog, pour la boîte de choix de dossier) est déjà
    référencé avec son nom complet dans le code.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
