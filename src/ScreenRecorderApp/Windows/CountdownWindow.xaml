<Window x:Class="ScreenRecorderApp.Windows.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Width="220" Height="220"
        WindowStartupLocation="Manual">
    <Grid>
        <Ellipse Width="200" Height="200" Fill="#E61E1E26"/>
        <Ellipse Width="200" Height="200" Stroke="#5B8CFF" StrokeThickness="5"/>
        <TextBlock x:Name="NumberText" Text="3" FontSize="120" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <ScaleTransform x:Name="NumberScale" ScaleX="1" ScaleY="1"/>
            </TextBlock.RenderTransform>
        </TextBlock>
    </Grid>
</Window>
